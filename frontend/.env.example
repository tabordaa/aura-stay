VITE_APP_NAME="Aura Food"

# URL del backend (FastAPI). Si no se define, se usa http://localhost:8000
VITE_API_URL="http://localhost:8000"

# Dirección de recogida que ve el domiciliario en sus pedidos
VITE_PICKUP_ADDRESS="Punto de recogida Aura Food"

# Inicio de sesión con Google (opcional): el mismo ID de cliente que GOOGLE_CLIENT_ID del backend.
# Si se deja vacío, el botón "Continuar con Google" no aparece.
VITE_GOOGLE_CLIENT_ID=""
